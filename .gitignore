.DS_Store
target/
# Every `CARGO_TARGET_DIR` under the repository root, not just the default
# one. `target2/` was not covered, and three commits in this branch swept
# 142,990 build artefacts into git before anyone noticed — `git add -A` sees
# whatever `.gitignore` does not.
/target*/

# §12 corpora are fetched, never committed (fixtures/bench/download.sh).
/fixtures/bench/*/

# Python bytecode from scripts/
__pycache__/

# Acquired upstream trees and private qualification artifacts are retained locally.
# Review summaries and reproducible tooling live in docs/review-integration and scripts.
/qualification/
# Belt and braces for the qualification application (T-2-8): its ThruLine store and its own
# runtime store carry real transcript content and must never be committed, even if the line
# above is ever narrowed.
qualification/retry-delivery/.thruline/
qualification/retry-delivery/data/

# The final qualification archive: binaries, SQLite stores and session rollouts.
# Production HQ runs its binary from inside it, so it stays in place and is
# never committed; `git add -A` must not be able to sweep it in.
/qualification-archive-final/

# Delivery-loop coder/verifier reports: machine-local evidence, deposited to the evidence folder, never committed
# Loop reports are force-added on purpose (sprint rule 2026-09-22): the directory is ignored so nothing lands
# by accident, and each verifier report / gate log is `git add -f`ed by the Prompter after the private scan.
docs/loop/reports/

# R-2026-09-23-7 — captured verification evidence and generated lockfiles. Each
# line below names the script or deposit that regenerates the path; the files
# stay on disk, and the commits that added them keep them in history. Untracked
# because `grep -rn <basename> crates scripts ui/src spec .github` found no test
# and no script that OPENS them — only scripts that WRITE them.
# Regenerated by scripts/verification_pack2_examples.py and scripts/export-pack2-ui-evidence.py.
docs/verification/pack2/
# Regenerated by scripts/verification_pack3_examples.py and scripts/evaluate-pack3-heldout.py.
docs/verification/pack3/
# Written by scripts/validate-verification-real-source.py (its output directory).
docs/verification/receipts/
# Captured `cargo test` / `npm test` logs from a verification run; no reader.
docs/verification/test-results/
# Captured demo run output; no reader.
docs/verification/demo-results.json
# A copy of the qualification root's lock (`qualification/open-source-review/20260912-initial/`,
# itself gitignored), written by scripts/review-integration-bootstrap.py. The review-integration
# scripts read the qualification root's copy, never this one, and this one carries literal
# machine paths (R19 history audit).
spec/review-integration/repositories.lock.json
# Machine-specific license provenance captured during a qualification run; cited by path as a
# metadata string in spec/integrations/catalog.json (that citation is kept) but opened by nothing.
spec/integrations/license-provenance.json
# The commit-E2 invariance capture at the `narrator-baseline-2` tag, regenerated by
# `scripts/hq-invariance.sh narrator-baseline-2 <out-dir>`. Unlike docs/audit/narrator-baseline/,
# which ui/src/workspace/{verdict-panel,review-model}.test.js read as fixtures, nothing opens this one.
docs/audit/narrator-baseline-2/

# Local-only tooling caches and media, never committed (2026-10-05 takeover).
.wrangler/
/teaser/
